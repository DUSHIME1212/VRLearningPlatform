  m_Script: {fileID: 11500000, guid: 394371d89e7d3e74aa97ef03450fd932, type: 3}
  m_Name: Quiz_SimpleMachines_Lever
  m_EditorClassIdentifier: Assembly-CSharp::VRLearning.Data.QuizDefinition
  QuizId: quiz_lever_01
  ModuleId: simple_machines
  Title: The Lever
  Questions:
  - Question: What is the fixed point that a lever turns around?
    Options:
    - Fulcrum
    - Load
    - Effort
    - Beam
    CorrectIndex: 0
    Explanation: The fulcrum is the fixed pivot point; the lever arm rotates around it.
  - Question: The force you apply to a lever to move the load is called the...
    Options:
    - Load
    - Effort
    - Fulcrum
    - Friction
    CorrectIndex: 1
    Explanation: Effort is the input force you apply; the load is the weight you are lifting.
  - Question: Moving the fulcrum closer to the load makes lifting the load...
    Options:
    - Easier
    - Harder
    - Impossible
    - No different
    CorrectIndex: 0
    Explanation: A shorter distance from fulcrum to load gives more mechanical advantage, so less effort is needed.
  - Question: A lever helps you by letting you trade...
    Options:
    - Distance for force
    - Energy for mass
    - Time for money
    - Heat for light
    CorrectIndex: 0
    Explanation: You move the effort end a longer distance to move the load a shorter distance with more force.
  CorrectClip: {fileID: 0}
  WrongClip: {fileID: 0}
  CompleteClip: {fileID: 0}
  PassThreshold: 0.6
