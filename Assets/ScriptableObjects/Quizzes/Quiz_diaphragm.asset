  m_Name: Quiz_diaphragm
  m_EditorClassIdentifier: Assembly-CSharp::VRLearning.Data.QuizDefinition
  QuizId: quiz_diaphragm
  ModuleId: breathing
  Title: The Diaphragm
  Questions:
  - Question: The diaphragm is a ___ below the lungs.
    Options:
    - Muscle
    - Bone
    - Tube
    - Valve
    CorrectIndex: 0
    Explanation: The diaphragm is a large dome-shaped muscle.
  - Question: When the diaphragm contracts, it moves...
    Options:
    - Down and flattens
    - Up and domes
    - Sideways
    - Nowhere
    CorrectIndex: 0
    Explanation: Contracting pulls it down, expanding the chest to inhale.
  - Question: The muscles between the ribs that help breathing are the...
    Options:
    - Intercostal muscles
    - Biceps
    - Cardiac muscle
    - Hamstrings
    CorrectIndex: 0
    Explanation: Intercostal muscles lift and lower the rib cage.
  CorrectClip: {fileID: 0}
  WrongClip: {fileID: 0}
  CompleteClip: {fileID: 0}
  PassThreshold: 0.6
