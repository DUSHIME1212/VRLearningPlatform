  m_Name: Quiz_artery
  m_EditorClassIdentifier: Assembly-CSharp::VRLearning.Data.QuizDefinition
  QuizId: quiz_artery
  ModuleId: blood_circulation
  Title: Arteries
  Questions:
  - Question: Arteries carry blood ___ the heart.
    Options:
    - Away from
    - Toward
    - Around
    - Into
    CorrectIndex: 0
    Explanation: Arteries carry blood away from the heart; veins return it.
  - Question: Artery walls are thick and muscular mainly to withstand...
    Options:
    - High pressure
    - Low temperature
    - Gravity
    - Light
    CorrectIndex: 0
    Explanation: Blood leaves the heart under high pressure, so artery walls are
      strong.
  - Question: The hollow space inside an artery where blood flows is the...
    Options:
    - Lumen
    - Valve
    - Node
    - Septum
    CorrectIndex: 0
    Explanation: The lumen is the open channel blood flows through.
  CorrectClip: {fileID: 0}
  WrongClip: {fileID: 0}
  CompleteClip: {fileID: 0}
  PassThreshold: 0.6
