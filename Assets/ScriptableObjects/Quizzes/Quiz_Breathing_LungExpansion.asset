  m_Script: {fileID: 11500000, guid: 394371d89e7d3e74aa97ef03450fd932, type: 3}
  m_Name: Quiz_Breathing_LungExpansion
  m_EditorClassIdentifier: Assembly-CSharp::VRLearning.Data.QuizDefinition
  QuizId: quiz_lungexpansion_01
  ModuleId: breathing
  Title: Lung Expansion
  Questions:
  - Question: Air enters the lungs through which tube?
    Options:
    - Trachea (windpipe)
    - Oesophagus
    - Aorta
    - Spine
    CorrectIndex: 0
    Explanation: Air travels down the trachea, or windpipe, on its way to the lungs.
  - Question: The trachea branches into two tubes called the...
    Options:
    - Bronchi
    - Alveoli
    - Ribs
    - Veins
    CorrectIndex: 0
    Explanation: The two bronchi carry air into the left and right lungs.
  - Question: When you breathe in, the lungs...
    Options:
    - Expand and fill with air
    - Shrink and empty
    - Stay exactly the same
    - Turn solid
    CorrectIndex: 0
    Explanation: During inhalation the chest enlarges and the lungs expand to draw air in.
  - Question: The dome-shaped muscle below the lungs is the...
    Options:
    - Diaphragm
    - Heart
    - Liver
    - Stomach
    CorrectIndex: 0
    Explanation: The diaphragm sits under the lungs and drives breathing.
  CorrectClip: {fileID: 0}
  WrongClip: {fileID: 0}
  CompleteClip: {fileID: 0}
  PassThreshold: 0.6
