  m_Name: Quiz_heart
  m_EditorClassIdentifier: Assembly-CSharp::VRLearning.Data.QuizDefinition
  QuizId: quiz_heart
  ModuleId: blood_circulation
  Title: The Heart
  Questions:
  - Question: Which chamber pumps oxygen-rich blood to the whole body?
    Options:
    - Left ventricle
    - Right ventricle
    - Left atrium
    - Right atrium
    CorrectIndex: 0
    Explanation: The left ventricle is the strongest chamber and pumps to the body.
  - Question: What stops blood flowing backward in the heart?
    Options:
    - Valves
    - Nerves
    - Bones
    - Skin
    CorrectIndex: 0
    Explanation: Heart valves open one way and shut to prevent backflow.
  - Question: The largest artery leaving the heart is the...
    Options:
    - Aorta
    - Vena cava
    - Pulmonary vein
    - Capillary
    CorrectIndex: 0
    Explanation: The aorta carries blood from the heart out to the body.
  CorrectClip: {fileID: 0}
  WrongClip: {fileID: 0}
  CompleteClip: {fileID: 0}
  PassThreshold: 0.6
