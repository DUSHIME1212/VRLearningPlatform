  m_Script: {fileID: 11500000, guid: 394371d89e7d3e74aa97ef03450fd932, type: 3}
  m_Name: Quiz_Breathing_Diaphragm
  m_EditorClassIdentifier: Assembly-CSharp::VRLearning.Data.QuizDefinition
  QuizId: quiz_diaphragm_01
  ModuleId: breathing
  Title: The Diaphragm
  Questions:
  - Question: When the diaphragm contracts, it moves...
    Options:
    - Down and flattens
    - Up and domes
    - Sideways
    - Nowhere
    CorrectIndex: 0
    Explanation: Contracting pulls the diaphragm downward and flat, making room for the lungs to expand.
  - Question: Contracting the diaphragm makes the chest cavity...
    Options:
    - Larger
    - Smaller
    - Warmer
    - Heavier
    CorrectIndex: 0
    Explanation: A larger chest cavity lowers the pressure inside, so air rushes in.
  - Question: The muscles between the ribs that help breathing are the...
    Options:
    - Intercostal muscles
    - Biceps
    - Calf muscles
    - Jaw muscles
    CorrectIndex: 0
    Explanation: Intercostal muscles lift and lower the rib cage during breathing.
  - Question: When you breathe out, the diaphragm...
    Options:
    - Relaxes and rises
    - Contracts and lowers
    - Splits in two
    - Stops existing
    CorrectIndex: 0
    Explanation: On exhalation the diaphragm relaxes and domes upward, pushing air out.
  CorrectClip: {fileID: 0}
  WrongClip: {fileID: 0}
  CompleteClip: {fileID: 0}
  PassThreshold: 0.6
